<?php

namespace App\Services\{{name}};

use App\Models\{{model}};
use App\Repositories\Contracts\{{name}}RepositoryInterface;
use App\Services\BaseService;
use App\Services\Contracts\{{name}}ServiceInterface;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Pagination\LengthAwarePaginator;
use Exception;
use Illuminate\Support\Facades\Log;

/**
 * Class {{name}}Service
 * 
 * @package App\Services\{{name}}
 */
class {{name}}Service extends BaseService implements {{name}}ServiceInterface
{
    /**
     * @var {{name}}RepositoryInterface
     */
    protected $repo;
    
    /**
     * {{name}}Service constructor.
     * 
     * @param {{name}}RepositoryInterface $repository
     */
    public function __construct({{name}}RepositoryInterface $repository)
    {
        parent::__construct($repository);
    }
    
    /**
     * Find {{name}} by custom attribute
     * 
     * @param string $attribute
     * @param mixed $value
     * @return {{model}}|null
     */
    public function findBy{{name}}Attribute(string $attribute, mixed $value): ?{{model}}
    {
        try {
            return $this->repo->findBy{{name}}Attribute($attribute, $value);
        } catch (Exception $e) {
            Log::error('Error finding {{name}} by attribute: ' . $e->getMessage());
            return null;
        }
    }
    
    /**
     * Get all {{name}} items with specific criteria
     * 
     * @param array $criteria
     * @return Collection|LengthAwarePaginator
     */
    public function getCustom{{name}}List(array $criteria = []): Collection|LengthAwarePaginator
    {
        $query = $this->repo->getQuery();
        
        // Apply custom criteria
        if (!empty($criteria)) {
            foreach ($criteria as $key => $value) {
                $query->where($key, $value);
            }
        }
        
        // Apply relation, filter, sort, and select
        $query = $this->relation($query, $this->relations);
        $query = $this->filter($query, $this->filter_fields);
        $query = $this->sort($query);
        $query = $this->select($query, $this->attributes);
        
        // Return results with pagination if specified
        return $this->repo->getPaginate($query, $this->filter_fields['per_page'] ?? null);
    }
}

